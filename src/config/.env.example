PORT=8080
# Optional, defaults to 127.0.0.1
HOST=127.0.0.1
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173

DB_PORT=5432
DB_HOST=localhost
DB_NAME=your_db
DB_USER=postgres
DB_PASSWORD=your_password
# Optional, defaults to 5
DB_POOL_SIZE=5

SECRET_KEY=your_jwt_secret
